# S.M.A.R.T. Chess Robot - local development environment template.
# Copy this file to .env, then replace secrets before running real hardware or production.

# ---------------------------------------------------------------------------
# Runtime profile
# ---------------------------------------------------------------------------
APP_ENV=development
SYSTEM_MODE=simulation
TEST_MODE=false
LOG_LEVEL=INFO
LOG_QUEUE_SIZE=10000
CONTRACT_VALIDATE=true

# Bind only to localhost by default.
SMART_CHESS_HOST=127.0.0.1
SMART_CHESS_BIND_ALL=false
PORT=5000

# ---------------------------------------------------------------------------
# Security and API limits
# ---------------------------------------------------------------------------
CHESS_SECRET_KEY=replace-with-a-random-32-plus-character-secret
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
SETUP_PASSWORD=replace-with-a-strong-local-setup-password
ALLOW_INSECURE_DEFAULTS=false
CONTROL_AUTH_REQUIRED=true
JWT_TTL_MINUTES=120

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
SOCKET_PUBLIC_SNAPSHOT_ENABLED=true
EVENTBUS_ALLOW_LEGACY_DICT_EVENTS=true
SOCKET_ACTION_ALLOWLIST=START_ENGINE,STOP_ENGINE,SYNC_VISION,RESET,PAUSE,UNDO,RESUME

RATE_LIMITS_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=20
CONTROL_RATE_LIMIT_PER_MINUTE=120
SOCKET_RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576
MAX_SOCKET_PAYLOAD_BYTES=65536

TRUST_X_FORWARDED_FOR=false
TRUSTED_PROXY_IPS=

# Production hardening notes:
# - APP_ENV=production
# - SYSTEM_MODE=production
# - FAKE_ROBOT=false, FAKE_VISION=false, FAKE_AI=false
# - SOCKET_PUBLIC_SNAPSHOT_ENABLED=false
# - EVENTBUS_ALLOW_LEGACY_DICT_EVENTS=false
# - DB_PATH must be an absolute path
# - CHESS_SECRET_KEY, ADMIN_PASSWORD, and SETUP_PASSWORD must be strong non-default values

# ---------------------------------------------------------------------------
# Persistence, replay, and exports
# ---------------------------------------------------------------------------
DB_PATH=data/runtime/app.db
REPLAY_MAX_SESSION_EVENTS=1000
REPLAY_SAVE_EVERY_N_EVENTS=10
REPLAY_RETENTION_FILES=20

PERSISTENCE_DROP_WARNING_THRESHOLD=1
PERSISTENCE_DROP_WARNING_INTERVAL_SEC=5
EXCEL_EXPORT_EVENT_LIMIT=1000
AUTO_EXPORT_SESSION_RECORD=true
GAME_RECORD_EXPORT_DIR=logs/game_records

# ---------------------------------------------------------------------------
# Protected engine assets
# ---------------------------------------------------------------------------
ENGINE_PATH=backend/infrastructure/protected_assets/engine/pikafish-avx2.exe
NNUE_PATH=backend/infrastructure/protected_assets/engine/pikafish.nnue
ENGINE_PROBE_ON_BOOT=false
ENGINE_AUTO_ANALYZE=false
ENGINE_OUTPUT_QUEUE_SIZE=2000
AI_MODE_DEFAULT=companionship

# ---------------------------------------------------------------------------
# Simulation and automation switches
# ---------------------------------------------------------------------------
FAKE_ROBOT=true
FAKE_VISION=true
FAKE_AI=true
AUTO_EXECUTE_ROBOT=false
ROBOT_COMMAND_QUEUE_SIZE=200

# ---------------------------------------------------------------------------
# Vision runtime
# ---------------------------------------------------------------------------
YOLO_CONFIG_DIR=logs/ultralytics
CAMERA_INDEX=0
VISION_WORKER_PIPELINE_ENABLED=false
CAMERA_DISCOVERY_CACHE_TTL_SEC=10
VISION_PREPROCESS_MODE=fast
VISION_MJPEG_QUALITY=75
VISION_MJPEG_FPS=15
WARP_WIDTH=1000
WARP_HEIGHT=1000
VISION_CALIBRATION_MAX_DIM=960
VISION_CALIBRATION_FILE=data/vision_calibration.json
STABILITY_THRESHOLD=3

# OpenCV + YOLO detection
YOLO_MODEL_PATH=backend/infrastructure/protected_assets/vision/best.onnx
YOLO_DATASET_MAPPING_PATH=backend/infrastructure/protected_assets/vision/dataset_mapping.yaml
YOLO_TRAINING_ARGS_PATH=backend/infrastructure/protected_assets/vision/args.yaml
YOLO_MODEL_TYPE=yolo26
ULTRALYTICS_MIN_VERSION=8.4.55
YOLO_DNN_INPUT_SIZE=640
YOLO_OUTPUT_HAS_OBJECTNESS=false
YOLO_WARMUP_ON_LOAD=true
VISION_BBOX_ANCHOR_X=0.5
VISION_BBOX_ANCHOR_Y=0.5
VISION_DEVICE=cpu
VISION_CONFIDENCE=0.30
VISION_NMS_IOU=0.45
VISION_SMALL_OBJECT_AREA_RATIO=0.01

# ---------------------------------------------------------------------------
# Robot motion and gripper control
# ---------------------------------------------------------------------------
ROBOT_IP=192.168.1.1
ROBOT_PORT=502
ROBOT_MIN_SPEED=1
ROBOT_MAX_SPEED=80
ROBOT_TRAVEL_SPEED=30
ROBOT_LIFT_SPEED=30
ROBOT_APPROACH_SPEED=15
ROBOT_DEFAULT_ACCELERATION=60
ROBOT_MOTION_TIMEOUT_SEC=10
ROBOT_PLACE_Z_OFFSET=2

ROBOT_MOTION_REGISTER_BASE=7000
ROBOT_PROFILE_REGISTER_BASE=7012
ROBOT_STATUS_REGISTER=7100
ROBOT_STATUS_IDLE_VALUE=0
ROBOT_STATUS_MOVING_VALUE=1
ROBOT_STATUS_COMPLETE_VALUE=2
ROBOT_STATUS_ERROR_VALUE=3
ROBOT_HALT_REGISTER=7099
ROBOT_HALT_VALUE=1
ROBOT_COMMAND_HANDSHAKE_ENABLED=true
ROBOT_COMMAND_ID_REGISTER=6998
ROBOT_COMMAND_TRIGGER_REGISTER=6999
ROBOT_COMMAND_ACK_REGISTER=7101
ROBOT_ERROR_CODE_REGISTER=7102
ROBOT_COMMAND_TRIGGER_VALUE=1
ROBOT_COMMAND_CLEAR_VALUE=0
ROBOT_COMMAND_ID_WRAP=32767
ROBOT_COMMAND_ACK_TIMEOUT_SEC=2.0
ROBOT_REGISTER_SCALE=100
ROBOT_REGISTER_ENCODING=scaled_int32

ROBOT_GRIPPER_REGISTER=7098
ROBOT_GRIPPER_CLOSE_VALUE=1
ROBOT_GRIPPER_OPEN_VALUE=0
ROBOT_GRIPPER_FEEDBACK_ENABLED=true
ROBOT_GRIPPER_STATUS_REGISTER=7103
ROBOT_GRIPPER_OPENED_VALUE=0
ROBOT_GRIPPER_CLOSED_VALUE=1
ROBOT_GRIPPER_ERROR_VALUE=2
ROBOT_GRIPPER_FEEDBACK_TIMEOUT_SEC=2.0
ROBOT_GRIPPER_CLOSE_DWELL_SEC=0.5
ROBOT_GRIPPER_OPEN_DWELL_SEC=0.5
