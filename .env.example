# S.M.A.R.T. Chess Robot - simulation-safe template.
# Copy to .env for local work. Do not commit real secrets.

# ---------------------------------------------------------------------------
# Runtime profile
# ---------------------------------------------------------------------------
APP_ENV=development
SYSTEM_MODE=simulation
TEST_MODE=false
LOG_LEVEL=INFO
LOG_QUEUE_SIZE=10000
MONITORING_INTERVAL_SEC=1.0
CONTRACT_VALIDATE=true
SETUP_SETTINGS_FILE=data/setup_settings.json
COMMISSIONING_REPORT_FILE=data/commissioning_report.json

# Localhost by default. Use bind-all only for lab hardware tests.
SMART_CHESS_HOST=127.0.0.1
SMART_CHESS_BIND_ALL=false
PORT=5000

# ---------------------------------------------------------------------------
# Security and API limits
# ---------------------------------------------------------------------------
CHESS_SECRET_KEY=replace-with-a-random-32-plus-character-secret
ADMIN_PASSWORD=login
SETUP_PASSWORD=login
ALLOW_INSECURE_DEFAULTS=false
CONTROL_AUTH_REQUIRED=true
JWT_TTL_MINUTES=120
JWT_REVOCATION_DB_PATH=data/runtime/app.db

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
SOCKET_PUBLIC_SNAPSHOT_ENABLED=true
EVENTBUS_ALLOW_LEGACY_DICT_EVENTS=true
SOCKET_ACTION_ALLOWLIST=START_ENGINE,STOP_ENGINE,SYNC_VISION,RESET,PAUSE,UNDO,RESUME

RATE_LIMITS_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=20
CONTROL_RATE_LIMIT_PER_MINUTE=120
SOCKET_RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=4194304
MAX_SOCKET_PAYLOAD_BYTES=65536

TRUST_X_FORWARDED_FOR=false
TRUSTED_PROXY_IPS=

# ---------------------------------------------------------------------------
# Persistence, replay, and exports
# ---------------------------------------------------------------------------
DB_PATH=data/runtime/app.db
REPLAY_MAX_SESSION_EVENTS=1000
REPLAY_SAVE_EVERY_N_EVENTS=10
REPLAY_RETENTION_FILES=20

PERSISTENCE_CRITICAL_QUEUE_SIZE=500
PERSISTENCE_CRITICAL_EVENT_TYPES=ROBOT_MOVE_REQUESTED,ROBOT_MOVE_STARTED,ROBOT_MOVE_COMPLETED,ROBOT.STATUS_UPDATED,ENGINE_MOVE_GENERATED,ENGINE_ANALYSIS_COMPLETED,VISION_MOVE_DETECTED,GAME_PLAYER_MOVE,MOVE_APPLIED,SYSTEM_ERROR,SYSTEM_RESET
PERSISTENCE_DROP_WARNING_THRESHOLD=1
PERSISTENCE_DROP_WARNING_INTERVAL_SEC=5
EVENT_STORE_RETENTION_DAYS=0
EVENT_STORE_VACUUM_AFTER_RETENTION=false
EXCEL_EXPORT_EVENT_LIMIT=1000
AUTO_EXPORT_SESSION_RECORD=true
GAME_RECORD_EXPORT_DIR=logs/game_records

# ---------------------------------------------------------------------------
# Protected engine assets
# ---------------------------------------------------------------------------
ENGINE_PATH=backend/infrastructure/protected_assets/engine/pikafish-avx2.exe
NNUE_PATH=backend/infrastructure/protected_assets/engine/pikafish.nnue
ENGINE_PROBE_ON_BOOT=false
ENGINE_AUTO_ANALYZE=false
ENGINE_OUTPUT_QUEUE_SIZE=2000
AI_MODE_DEFAULT=companionship

# ---------------------------------------------------------------------------
# Simulation and automation switches
# ---------------------------------------------------------------------------
FAKE_ROBOT=true
FAKE_VISION=true
FAKE_AI=true
AUTO_EXECUTE_ROBOT=false

# ---------------------------------------------------------------------------
# Vision runtime
# ---------------------------------------------------------------------------
YOLO_CONFIG_DIR=logs/ultralytics
VISION_RUNTIME_OWNER=vision_system
VISION_WORKER_PIPELINE_ENABLED=false
VISION_ALLOW_SIMULATION_FALLBACK=false
VISION_DEGRADED_CONSECUTIVE_FAILURES=30
VISION_DEGRADED_FAILURE_SECONDS=20.0
CAMERA_INDEX=0
CAMERA_DISCOVERY_CACHE_TTL_SEC=10
VISION_SOURCE=opencv

# OpenCV source. Leave VISION_OPENCV_SOURCE empty for camera index.
VISION_OPENCV_SOURCE=
VISION_CAPTURE_WIDTH=0
VISION_CAPTURE_HEIGHT=0
VISION_CAPTURE_FPS=0
VISION_CAPTURE_FOURCC=MJPG
VISION_CAPTURE_BUFFER_SIZE=1
VISION_CAPTURE_GRAB_DRAIN=0
VISION_CAPTURE_THREAD_FPS_LIMIT=0

VISION_PREPROCESS_MODE=fast
VISION_MJPEG_QUALITY=75
VISION_MJPEG_FPS=15
VISION_USER_CAPTURE_INTERVAL_SEC=2.0
VISION_USER_CAPTURE_TIMEOUT_SEC=30.0
VISION_RESULT_MAX_AGE_SEC=3.0
WARP_WIDTH=1000
WARP_HEIGHT=1000
VISION_CALIBRATION_MAX_DIM=960
VISION_CALIBRATION_FILE=data/vision_calibration.json
STABILITY_THRESHOLD=3
VISION_BOARD_RECONCILE_ENABLED=true
VISION_BOARD_FUSION_MIN_VOTES=1
VISION_BOARD_RECONCILE_MIN_SCORE=12.0
VISION_BOARD_RECONCILE_MIN_MARGIN=2.0

# YOLO / SAHI
YOLO_MODEL_PATH=backend/infrastructure/protected_assets/vision/best.pt
YOLO_DATASET_MAPPING_PATH=backend/infrastructure/protected_assets/vision/dataset_mapping.yaml
YOLO_TRAINING_ARGS_PATH=backend/infrastructure/protected_assets/vision/args.yaml
YOLO_MODEL_TYPE=yolo26
ULTRALYTICS_MIN_VERSION=8.4.55
YOLO_DNN_INPUT_SIZE=640
YOLO_OUTPUT_HAS_OBJECTNESS=false
YOLO_WARMUP_ON_LOAD=true
YOLO_USE_SAHI=true
VISION_BBOX_ANCHOR_X=0.5
VISION_BBOX_ANCHOR_Y=0.5
VISION_DEVICE=cpu
VISION_CONFIDENCE=0.30
VISION_NMS_IOU=0.45
VISION_SMALL_OBJECT_AREA_RATIO=0.01

# TMvision/EIH or legacy TMflow frame source.
# For lab real robot with tmvision_http, set a non-empty ingest key.
VISION_TMFLOW_IMAGE_HOST=192.168.10.10
VISION_TMFLOW_IMAGE_PORT=5891
VISION_TMFLOW_IMAGE_TIMEOUT_SEC=2.0
VISION_TMFLOW_IMAGE_MAX_MESSAGE_BYTES=4194304
VISION_TMFLOW_IMAGE_FPS_LIMIT=2.0
VISION_TMFLOW_INGEST_KEY=

# TMflow Network Node -> PC TCP status/pose ingest.
TMFLOW_INGEST_SERVER_ENABLED=false
TMFLOW_INGEST_SERVER_HOST=0.0.0.0
TMFLOW_INGEST_SERVER_PORT=9001
TMFLOW_INGEST_MAX_MESSAGE_BYTES=1048576
TMFLOW_INGEST_SEND_ACK=true
TMFLOW_INGEST_KEY=
TMFLOW_INGEST_ALLOW_TRUSTED_LAB_IPS=true
TMFLOW_INGEST_TELEMETRY_MAX_AGE_SEC=3.0

# ---------------------------------------------------------------------------
# Robot connection
# ---------------------------------------------------------------------------
ROBOT_ADAPTER=tmflow_json
ROBOT_IP=192.168.10.10
ROBOT_PORT=5890
ROBOT_PC_IP=192.168.10.50
ROBOT_SUBNET_MASK=255.255.0.0
ROBOT_CONNECT_TIMEOUT_SEC=3.0
TMFLOW_VERSION=1.82
TM_CONTROLLER_VERSION=1.82.51

# TMflow JSON / TechmanPy fallback path.
ROBOT_TMFLOW_PROTOCOL_VERSION=1.0
ROBOT_TMFLOW_CLIENT_VERSION=1.0
ROBOT_TMFLOW_WIRE_FORMAT=envelope
ROBOT_TMFLOW_REQUIRE_HELLO=true
ROBOT_TMFLOW_ACK_TIMEOUT_SEC=2.0
ROBOT_TMFLOW_DONE_TIMEOUT_SEC=30.0
ROBOT_TMFLOW_LONG_TASK_TIMEOUT_SEC=90.0
ROBOT_TMFLOW_HEARTBEAT_INTERVAL_SEC=1.0
ROBOT_TMFLOW_RECONNECT_INTERVAL_SEC=2.0
ROBOT_TMFLOW_MAX_RETRY=2
ROBOT_TMFLOW_MAX_MESSAGE_BYTES=4096
ROBOT_TMFLOW_BASE=ChessBoard_Base
ROBOT_TMFLOW_TCP=ChessGripper_TCP
ROBOT_TMFLOW_GRIPPER_WAIT_MS=300
ROBOT_TMFLOW_STOP_MODE=CONTROLLED_STOP
ROBOT_TECHMANPY_REQUIRE_LISTEN_NODE=true
ROBOT_TECHMANPY_MOTION_MODE=ptp
ROBOT_TECHMANPY_SUPPRESS_WARNINGS=false
ROBOT_GRIPPER_CLOSE_SCRIPT=
ROBOT_GRIPPER_OPEN_SCRIPT=

# Robot motion safety limits.
Z_SAFE=150
Z_GRAB=20
ROBOT_MIN_X=-600
ROBOT_MAX_X=600
ROBOT_MIN_Y=100
ROBOT_MAX_Y=600
ROBOT_MIN_Z=0
ROBOT_MAX_Z=250
ROBOT_MIN_SPEED=1
ROBOT_MAX_SPEED=80
ROBOT_TRAVEL_SPEED=30
ROBOT_LIFT_SPEED=30
ROBOT_APPROACH_SPEED=15
ROBOT_DEFAULT_ACCELERATION=60
ROBOT_MOTION_TIMEOUT_SEC=10
ROBOT_HALT_TIMEOUT_SEC=1.5
ROBOT_PLACE_Z_OFFSET=2
ROBOT_TOOL_RX=0
ROBOT_TOOL_RY=0
ROBOT_TOOL_RZ=0

# Modbus compatibility path. Lab real robot uses server + square_command.
ROBOT_MODBUS_ROLE=client
ROBOT_MODBUS_SERVER_HOST=192.168.10.50
ROBOT_MODBUS_SERVER_PORT=502
ROBOT_MODBUS_PAYLOAD_MODE=pose
ROBOT_MODBUS_REGISTER_ADDRESSING=holding_40001
ROBOT_MOTION_REGISTER_BASE=7000
ROBOT_PROFILE_REGISTER_BASE=7012
ROBOT_STATUS_REGISTER=7100
ROBOT_STATUS_IDLE_VALUE=0
ROBOT_STATUS_MOVING_VALUE=1
ROBOT_STATUS_COMPLETE_VALUE=2
ROBOT_STATUS_ERROR_VALUE=3
ROBOT_STATUS_FAULT_VALUE=4
ROBOT_HALT_REGISTER=7099
ROBOT_HALT_VALUE=1
ROBOT_COMMAND_HANDSHAKE_ENABLED=true
ROBOT_COMMAND_ID_REGISTER=6998
ROBOT_COMMAND_TRIGGER_REGISTER=6999
ROBOT_COMMAND_ACK_REGISTER=7101
ROBOT_ERROR_CODE_REGISTER=7102
ROBOT_COMMAND_TRIGGER_VALUE=1
ROBOT_COMMAND_CLEAR_VALUE=0
ROBOT_COMMAND_ID_WRAP=32767
ROBOT_COMMAND_ACK_TIMEOUT_SEC=2.0

# Modbus square-command contract.
ROBOT_SQUARE_COMMAND_REGISTER_BASE=40001
ROBOT_SQUARE_FROM_REGISTER=40001
ROBOT_SQUARE_TO_REGISTER=40002
ROBOT_SQUARE_ACTION_REGISTER=40003
ROBOT_SQUARE_COMMAND_ID_REGISTER=40004
ROBOT_SQUARE_TRIGGER_REGISTER=40005
ROBOT_SQUARE_STATUS_REGISTER=40006
ROBOT_SQUARE_ERROR_CODE_REGISTER=40007
ROBOT_SQUARE_COMPLETED_COMMAND_REGISTER=40008
ROBOT_SQUARE_HEARTBEAT_REGISTER=40009
ROBOT_SQUARE_ROBOT_STATE_REGISTER=40010
ROBOT_SQUARE_REQUIRE_COMPLETED_COMMAND=true
ROBOT_SQUARE_FILES=abcdefghi
ROBOT_SQUARE_RANKS=0123456789
ROBOT_SQUARE_INDEX_BASE=0
ROBOT_SQUARE_ACTION_NORMAL_VALUE=0
ROBOT_SQUARE_ACTION_CAPTURE_VALUE=1
ROBOT_SQUARE_ACTION_PROMOTION_VALUE=3

# Modbus pose/register telemetry.
ROBOT_REGISTER_SCALE=100
ROBOT_REGISTER_ENCODING=scaled_int32
ROBOT_TELEMETRY_ENABLED=false
ROBOT_TELEMETRY_POSE_REGISTER_BASE=7110
ROBOT_TELEMETRY_JOINT_REGISTER_BASE=7122
ROBOT_TELEMETRY_SPEED_REGISTER=7134
ROBOT_VERIFY_STATUS_ON_CONNECT=false

# Gripper.
ROBOT_GRIPPER_REGISTER=7098
ROBOT_GRIPPER_CLOSE_VALUE=1
ROBOT_GRIPPER_OPEN_VALUE=0
ROBOT_GRIPPER_FEEDBACK_ENABLED=true
ROBOT_GRIPPER_STATUS_REGISTER=7103
ROBOT_GRIPPER_OPENED_VALUE=0
ROBOT_GRIPPER_CLOSED_VALUE=1
ROBOT_GRIPPER_ERROR_VALUE=2
ROBOT_GRIPPER_FEEDBACK_TIMEOUT_SEC=2.0
ROBOT_GRIPPER_CLOSE_DWELL_SEC=0.5
ROBOT_GRIPPER_OPEN_DWELL_SEC=0.5

# ---------------------------------------------------------------------------
# Production notes
# ---------------------------------------------------------------------------
# Production requires APP_ENV=production, SYSTEM_MODE=production, strong secrets,
# no fake modules, no simulation fallback, non-public socket snapshots, no legacy
# dict events, absolute database paths, and non-empty TMvision/TMflow ingest keys
# when those network ingest paths are enabled.
