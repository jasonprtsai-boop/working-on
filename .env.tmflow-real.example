# TMflow 1.82 lab real-hardware profile.
# Copy only after assigning real lab IPs and non-empty keys.

APP_ENV=development
SYSTEM_MODE=lab_real_robot
FAKE_ROBOT=false
FAKE_VISION=false
FAKE_AI=false
AUTO_EXECUTE_ROBOT=false

# Flask must be reachable from the robot controller for TMvision HTTP POSTs.
SMART_CHESS_BIND_ALL=1
SMART_CHESS_HOST=0.0.0.0
PORT=5000
CHESS_SECRET_KEY=replace-with-32-plus-character-secret
CORS_ALLOWED_ORIGINS=http://192.168.10.50:5000

# Lab network.
ROBOT_IP=192.168.10.10
ROBOT_PC_IP=192.168.10.50
ROBOT_SUBNET_MASK=255.255.0.0

# Image channel: TMvision/EIH External Classification or External Detection -> Python HTTP.
VISION_SOURCE=tmvision_http
VISION_TMFLOW_INGEST_KEY=replace-with-shared-tmvision-key
VISION_TMFLOW_IMAGE_MAX_MESSAGE_BYTES=4194304
YOLO_MODEL_PATH=backend/infrastructure/protected_assets/vision/best.pt
YOLO_USE_SAHI=true
VISION_CONFIDENCE=0.30
VISION_NMS_IOU=0.45
VISION_DEVICE=cpu

# Telemetry channel: TMflow Network Node -> Python TCP ingest.
# Optional for the current Set-only Modbus test. If this key is set, send JSON
# messages with the key; simple CSV such as HB,0 is accepted only when the key is blank.
TMFLOW_INGEST_SERVER_ENABLED=true
TMFLOW_INGEST_SERVER_HOST=0.0.0.0
TMFLOW_INGEST_SERVER_PORT=9001
TMFLOW_INGEST_SEND_ACK=true
TMFLOW_INGEST_KEY=replace-with-shared-telemetry-key
TMFLOW_INGEST_TELEMETRY_MAX_AGE_SEC=3.0

# Command channel: Python Modbus server, TMflow polls square commands.
ROBOT_ADAPTER=modbus
ROBOT_MODBUS_ROLE=server
ROBOT_MODBUS_SERVER_HOST=192.168.10.50
# Use 1502 during Windows/lab commissioning; switch to 502 only when allowed and required.
ROBOT_MODBUS_SERVER_PORT=1502
ROBOT_MODBUS_PAYLOAD_MODE=square_command
ROBOT_MODBUS_REGISTER_ADDRESSING=holding_40001

# Square-command register contract.
ROBOT_SQUARE_COMMAND_REGISTER_BASE=40001
ROBOT_SQUARE_FROM_REGISTER=40001
ROBOT_SQUARE_TO_REGISTER=40002
ROBOT_SQUARE_ACTION_REGISTER=40003
ROBOT_SQUARE_COMMAND_ID_REGISTER=40004
ROBOT_SQUARE_TRIGGER_REGISTER=40005
ROBOT_SQUARE_STATUS_REGISTER=40006
ROBOT_SQUARE_ERROR_CODE_REGISTER=40007
ROBOT_SQUARE_COMPLETED_COMMAND_REGISTER=40008
ROBOT_SQUARE_HEARTBEAT_REGISTER=40009
ROBOT_SQUARE_ROBOT_STATE_REGISTER=40010
ROBOT_SQUARE_REQUIRE_COMPLETED_COMMAND=true
ROBOT_SQUARE_FILES=abcdefghi
ROBOT_SQUARE_RANKS=0123456789
ROBOT_SQUARE_INDEX_BASE=0
ROBOT_SQUARE_ACTION_NORMAL_VALUE=0
ROBOT_SQUARE_ACTION_CAPTURE_VALUE=1
ROBOT_SQUARE_ACTION_PROMOTION_VALUE=3

# Keep automatic motion disabled until all commissioning checks pass.
ENGINE_AUTO_ANALYZE=false
ENGINE_PROBE_ON_BOOT=false
