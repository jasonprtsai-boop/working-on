{
  "name": "smart-chess-robot",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "check:versions": "node scripts/check_node_version.mjs",
    "pretest": "node scripts/check_node_version.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --env=jsdom",
    "check:system": "powershell.exe -ExecutionPolicy Bypass -File scripts/check_system.ps1 -SkipGitCleanCheck",
    "check:system:strict": "powershell.exe -ExecutionPolicy Bypass -File scripts/check_system.ps1",
    "cleanup:dry-run": ".venv\\Scripts\\python.exe scripts/maintenance/cleanup.py --dry-run",
    "audit:deps": ".venv\\Scripts\\python.exe scripts/audit_dependencies.py",
    "audit:artifacts": ".venv\\Scripts\\python.exe scripts/check_artifact_hygiene.py",
    "audit:events": ".venv\\Scripts\\python.exe scripts/check_legacy_events.py",
    "preflight:production": ".venv\\Scripts\\python.exe scripts/check_production_config.py --current --require-production",
    "quality": ".venv\\Scripts\\python.exe scripts/quality_gate.py",
    "check:html": "node scripts/html_function_check.mjs",
    "release:zip": ".venv\\Scripts\\python.exe scripts/build_release_zip.py",
    "share:zip": ".venv\\Scripts\\python.exe scripts/sanitize_for_share.py",
    "smoke:frontend": "node scripts/playwright_smoke.mjs",
    "dev": "echo \"Frontend is served by Flask. Run: python .\\\\main.py\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.60.0"
  }
}
