  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.60.0"
  }
